{
  "name": "@money-tracker/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/bundle-main.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist:win": "pnpm build && electron-builder install-app-deps && electron-builder --win nsis --x64 --config electron-builder.yml"
  },
  "dependencies": {
    "@money-tracker/core": "workspace:*",
    "@money-tracker/db": "workspace:*",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.7.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  }
}